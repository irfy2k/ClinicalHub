{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["role"],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "appointments": {
      ".read": "auth != null",
      ".indexOn": ["patient_id", "doctor_id"],
      "$appointmentId": {
        ".write": "auth != null"
      }
    },
    "prescriptions": {
      ".read": "auth != null",
      ".indexOn": ["patient_id", "doctor_id"],
      "$prescriptionId": {
        ".write": "auth != null"
      }
    },
    "medication_logs": {
      ".read": "auth != null",
      ".indexOn": ["prescription_id"],
      "$logId": {
        ".write": "auth != null"
      }
    },
    "health_expenses": {
      ".read": "auth != null",
      ".indexOn": ["patient_id"],
      "$expenseId": {
        ".write": "auth != null"
      }
    },
    "documents": {
      ".read": "auth != null",
      ".indexOn": ["patient_id"],
      "$docId": {
        ".write": "auth != null"
      }
    },
    "chat_messages": {
      ".read": "auth != null",
      ".indexOn": ["appointment_id"],
      "$messageId": {
        ".write": "auth != null"
      }
    }
  }
}
